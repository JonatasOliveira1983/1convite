{
  "appId": "com.spcompensa.umconvite",
  "appName": "1Convite",
  "webDir": "dist",
  "backgroundColor": "#070A10",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchFadeOutDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#070A10",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  },
  "server": {
    "url": "https://1convite.com.br",
    "cleartext": true,
    "allowNavigation": [
      "1convite.com.br",
      "*.1convite.com.br"
    ]
  }
}
