{
  "name": "1convite-backend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('../blog/package.json')){cp.execSync('npm --prefix ../blog install --omit=dev --no-audit --no-fund',{stdio:'inherit'})}\"",
    "dev": "node --watch src/index.js",
    "migrate": "node src/database/migrations.js",
    "seed": "node src/database/seed.js",
    "import-bible": "node import-bible.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-edge-tts": "^1.2.12",
    "pg": "^8.22.0"
  }
}
